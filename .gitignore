# =========================================
# KiCad Version Control Ignore File
# =========================================

# Local project settings (UI state, window positions, recently opened files)
*.kicad_prl

# Lock files created when a project or schematic is open
*.kicad_lock

# Backup files
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak
*_autosave*

# Netlists (if generated in the root directory)
*.net

# -----------------------------------------
# Optional: Fabrication & Plot Outputs
# -----------------------------------------
# Uncomment these if you generate Gerbers, drill files, or assembly PDFs 
# inside your repo and prefer to keep them untracked (recommended if 
# you generate them via CI/CD or right before ordering).
#
# /gerbers/
# /production/
# *.gbr
# *.drl
# *.pho
# *.pdf
# *.ps
# *.svg
# *.plt